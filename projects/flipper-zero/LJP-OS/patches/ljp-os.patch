 typedef DialogMessageButton (*AboutDialogScreen)(DialogsApp* dialogs, DialogMessage* message);
 
+static DialogMessageButton about_screen_ljp_os(DialogsApp* dialogs, DialogMessage* message) {
+    DialogMessageButton result;
+    const Version* ver = furi_hal_version_get_firmware_version();
+
+    FuriString* screen_text = furi_string_alloc_printf(
+        "Custom Flipper firmware\n"
+        "by LJP-Working\n"
+        "Based on Official %s",
+        ver ? version_get_version(ver) : "?");
+
+    dialog_message_set_header(message, "LJP-OS", 64, 2, AlignCenter, AlignTop);
+    dialog_message_set_text(
+        message, furi_string_get_cstr(screen_text), 64, 20, AlignCenter, AlignTop);
+    result = dialog_message_show(dialogs, message);
+
+    furi_string_free(screen_text);
+
+    return result;
+}
