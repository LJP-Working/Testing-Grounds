diff --git a/applications/services/gui/gui.c b/applications/services/gui/gui.c
index 24ea57b..c3c764e 100644
--- a/applications/services/gui/gui.c
+++ b/applications/services/gui/gui.c
@@ -1,8 +1,61 @@
 #include "gui_i.h"
 #include <assets_icons.h>
+#include <toolbox/saved_struct.h>
+
+#ifdef SRV_STORAGE
+#include <storage/storage.h>
+#endif
 
 #define TAG "GuiSrv"
 
+#define GUI_SETTINGS_PATH    INT_PATH(".gui.settings")
+#define GUI_SETTINGS_MAGIC   (0x4C) // 'L', LJP-OS
+#define GUI_SETTINGS_VERSION (1)
+
+typedef struct {
+    bool dark_mode;
+} GuiSettings;
+
+static void gui_settings_load(Gui* gui) {
+    // LJP-OS ships in dark mode until the user turns it off
+    GuiSettings settings = {.dark_mode = true};
+#ifdef SRV_STORAGE
+    GuiSettings loaded;
+    if(saved_struct_load(
+           GUI_SETTINGS_PATH, &loaded, sizeof(loaded), GUI_SETTINGS_MAGIC, GUI_SETTINGS_VERSION)) {
+        settings = loaded;
+    }
+#endif
+    canvas_set_inverted(gui->canvas, settings.dark_mode);
+}
+
+void gui_set_dark_mode(Gui* gui, bool dark_mode) {
+    furi_check(gui);
+
+    gui_lock(gui);
+    canvas_set_inverted(gui->canvas, dark_mode);
+    gui_unlock(gui);
+
+#ifdef SRV_STORAGE
+    GuiSettings settings = {.dark_mode = dark_mode};
+    if(!saved_struct_save(
+           GUI_SETTINGS_PATH,
+           &settings,
+           sizeof(settings),
+           GUI_SETTINGS_MAGIC,
+           GUI_SETTINGS_VERSION)) {
+        FURI_LOG_E(TAG, "Failed to save settings");
+    }
+#endif
+
+    gui_update(gui);
+}
+
+bool gui_get_dark_mode(Gui* gui) {
+    furi_check(gui);
+    return canvas_is_inverted(gui->canvas);
+}
